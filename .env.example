# Platform selector. Omit it to preserve the historical Feishu default.
CHAT2CODEX_ADAPTER=feishu

# Run `chat2codex setup --workdir /absolute/path/to/your/repo` to create
# and connect a Feishu/Lark app automatically,
# or fill these manually from the Feishu/Lark developer console.
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=
# Written by setup when available. Used to ignore group messages that do not
# explicitly mention this bot.
FEISHU_BOT_OPEN_ID=

# Use "feishu" for 飞书, "lark" for Lark global.
LARK_DOMAIN=feishu

# `chat2codex setup weixin` stores the ClawBot Token in this private JSON file,
# never in .env. Leave empty to use ~/.chat2codex/weixin/credentials.json.
WEIXIN_CREDENTIALS_PATH=
# Natural Chinese intent routing for the Weixin direct-message adapter.
WEIXIN_NATURAL_ROUTING=true
WEIXIN_INTENT_BASE_URL=http://127.0.0.1:23333/api/openai/v1
WEIXIN_INTENT_MODEL=gpt-5.6-sol
WEIXIN_INTENT_TIMEOUT_MS=8000
WEIXIN_INTENT_MIN_CONFIDENCE=0.78
# Image-only messages are staged until text instructions arrive.
WEIXIN_IMAGE_DRAFT_TTL_MS=1800000
WEIXIN_IMAGE_DRAFT_MAX_COUNT=4
WEIXIN_IMAGE_DRAFT_MAX_FILE_BYTES=26214400
WEIXIN_IMAGE_DRAFT_MAX_TOTAL_BYTES=52428800

# The directory Codex should work in by default.
CODEX_WORKDIR=/absolute/path/to/your/repo
# Foreground development can use `codex`. For the most reliable background
# service setup, replace it with an absolute path from `command -v codex`.
CODEX_BIN=codex
CODEX_SANDBOX=workspace-write
CODEX_APPROVAL_POLICY=never
# Routes approvals through automated risk review. Set user for direct review;
# this never changes CODEX_SANDBOX or CODEX_APPROVAL_POLICY.
CODEX_APPROVALS_REVIEWER=auto_review
# 0 disables automatic timeout. Set positive values for unattended team bots.
CODEX_RUN_TIMEOUT_MS=0
CODEX_APPROVAL_TIMEOUT_MS=0
# Global task capacity. Phase 1 production deployments use 4; every logical
# task still runs one turn at a time.
CODEX_MAX_CONCURRENT_RUNS=4
# Idle app-server sessions keep session-scoped grants in memory. Set 0 to
# disable idle eviction. The session cap must be at least the run concurrency.
CODEX_APP_SERVER_IDLE_TTL_MS=900000
CODEX_MAX_APP_SERVER_SESSIONS=8
CODEX_MODEL=
CODEX_SKIP_GIT_REPO_CHECK=false
# Group chats are constrained to CODEX_WORKDIR unless this comma-separated list is set.
# Direct messages are not constrained by this setting.
CODEX_GROUP_ALLOWED_ROOTS=
# Phase 3 Desktop Gateway is disabled by default. Repository examples are inert:
# do not create keys, copy into ~/.codex, trust Hooks, restart Desktop, or write
# production until each action receives separate Task 12 approval. The server
# accepts only exact IPv4 loopback 127.0.0.1 and distinct absolute owner-only
# token files; never place raw keys in environment variables.
CHAT2CODEX_DESKTOP_GATEWAY_ENABLED=false
CHAT2CODEX_DESKTOP_GATEWAY_PORT=43127
CHAT2CODEX_DESKTOP_PROMPT_TOKEN_FILE=
CHAT2CODEX_DESKTOP_STOP_TOKEN_FILE=
CHAT2CODEX_DESKTOP_MCP_TOKEN_FILE=
CHAT2CODEX_DESKTOP_GATEWAY_MAX_BODY_BYTES=65536
CHAT2CODEX_DESKTOP_GATEWAY_MAX_CONCURRENCY=16
CHAT2CODEX_DESKTOP_GATEWAY_DEADLINE_MS=2000
CHAT2CODEX_DESKTOP_HEARTBEAT_MS=10000
CHAT2CODEX_DESKTOP_LEASE_MS=30000
CHAT2CODEX_DESKTOP_RECONCILE_MS=15000
# Optional strict JSON map for Weixin natural task routing. If non-empty, all
# six keys are required and must name existing, distinct directories. Use one
# line in a real .env file. If empty, only CODEX_WORKDIR is available as work.
# Windows example only; replace <drive> and <you> with local values.
# CHAT2CODEX_WORKSPACE_ROUTES={"work":"<drive>:/Users/<you>/Chat2Codex/Work","travel":"<drive>:/Users/<you>/Chat2Codex/Travel","personal":"<drive>:/Users/<you>/Chat2Codex/Personal","finance":"<drive>:/Users/<you>/Chat2Codex/Finance","ai_lab":"<drive>:/Users/<you>/Chat2Codex/AI-Lab","learning":"<drive>:/Users/<you>/Chat2Codex/Learning"}
CHAT2CODEX_WORKSPACE_ROUTES=

# Access control. Direct routing is enabled by default, but a direct chat or
# sender must be explicitly allowlisted. Groups require both chat and sender
# allowlists. `chat2codex setup` adds the scanning user's open_id automatically.
ALLOW_DIRECT_MESSAGES=true
ALLOW_GROUPS=false
ALLOWED_CHAT_IDS=
ALLOWED_USER_IDS=

# Resource and retention limits. All values must be positive integers. Pending
# limits cover active jobs, undelivered replies, pending control messages, and
# in-turn approval/input waits.
BRIDGE_MAX_PENDING_MESSAGES=64
BRIDGE_MAX_PENDING_MESSAGES_PER_CHAT=8

ATTACHMENT_DOWNLOAD_DIR=.data/attachments
ATTACHMENT_MAX_COUNT=4
ATTACHMENT_MAX_FILE_BYTES=26214400
ATTACHMENT_MAX_TOTAL_BYTES=52428800
ATTACHMENT_STORE_MAX_BYTES=1073741824
ATTACHMENT_RETENTION_HOURS=24
# Explicit Codex deliverables are copied to immutable private snapshots before
# outbound delivery. Only an exact final CHAT2CODEX_OUTPUT_FILES JSON-array
# control line opts files in; mentions, diffs, inputs, logs, and changed files
# are never sent implicitly. Count is capped at 16 even when configured.
OUTBOUND_MEDIA_MAX_COUNT=16
OUTBOUND_MEDIA_MAX_FILE_BYTES=26214400
OUTBOUND_MEDIA_MAX_TOTAL_BYTES=52428800
OUTBOUND_MEDIA_RETENTION_HOURS=24
# Pending media is never deleted. Complete groups remain for at least this age
# before count-based job/outbox retention may remove the whole group.
CHAT_OUTPUT_MAX_CHARS=28000
CODEX_STDERR_MAX_BYTES=262144
RUN_LOG_MAX_COMMANDS=20
RUN_LOG_MAX_BYTES=65536
RUN_DIFF_MAX_CHARS=60000
LOG_ENTRY_MAX_BYTES=16384
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_MAX_FILES=3
JOB_RETENTION_COUNT=500
OUTBOX_RETENTION_COUNT=500
BRIDGE_STATE_PATH=.data/state.json
LOG_LEVEL=info
